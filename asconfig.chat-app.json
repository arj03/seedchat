{
  "entries": [
    "assembly/chat-app/index.ts"
  ],
  "targets": {
    "release": {
      "outFile": "build/chat-app.wasm",
      "textFile": "build/chat-app.wat",
      "optimizeLevel": 3,
      "shrinkLevel": 2,
      "converge": false,
      "noAssert": true,
      "exportRuntime": true
    }
  },
  "options": {
    "bindings": "raw",
    "maximumMemory": 256
  }
}
